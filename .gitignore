# ============================================================================
# CoreLauncher · .gitignore
# 目标：只提交启动器源码、文档与必要资源；构建产物、缓存、IDE 配置、
# 本地用户数据以及任何 Minecraft 游戏文件都不进入版本库。
# ============================================================================

# ---------------------------------------------------------------------------
# 构建产物
# ---------------------------------------------------------------------------
/build/
/dist/
/pyinstaller-build/
/out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile
*.o
*.obj
*.pdb
*.ilk
*.exp
*.idb
*.tlog
*.lastbuildstate
*.dll

# ---------------------------------------------------------------------------
# Windows / Visual Studio 中间文件
# ---------------------------------------------------------------------------
/bin/
/obj/
.vs/
*.suo
*.user
*.userossc
*.sln.docstates
*.VC.db
*.VC.opendb
*.ipch
*.ncb
*.sdf
*.opensdf
*.aps

# ---------------------------------------------------------------------------
# Python 缓存与虚拟环境
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/
ENV/
.eggs/
*.egg-info/
pip-wheel-metadata/

# ---------------------------------------------------------------------------
# IDE / 编辑器
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.code-workspace
.history/
*.swp
*~

# ---------------------------------------------------------------------------
# 操作系统
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# 第三方库的构建产物（third_party/curl-8.11.0.tar.gz 源码包保留提交）
# ---------------------------------------------------------------------------
/third_party/curl-build/
/third_party/curl-install/
/third_party/curl-8.11.0/

# ---------------------------------------------------------------------------
# 本地运行状态与用户配置（含登录凭证 / API Key，绝不提交）
# ---------------------------------------------------------------------------
launcher_config.json
launcher_settings.json
account.json
secrets.json
servers.json
/.auth/
/server_icons/
/updates/
/runtime/
/backups/
*.part
*.log
hs_err_pid*.log
launcher_update*.bat
corelauncher_update_error.txt

# ---------------------------------------------------------------------------
# Minecraft 游戏数据 —— 项目红线：任何原版 jar、资源、破解文件都不入库
# 说明：这些模式固定到仓库根目录，避免误伤 docs/ 等文档目录；真实的
# .minecraft 目录由下面的 .minecraft/ 匹配。
# ---------------------------------------------------------------------------
.minecraft/
*.jar
/mods/
/saves/
/logs/
/crash-reports/
/screenshots/
/resourcepacks/
/shaderpacks/
/libraries/
/versions/
/assets/objects/
/assets/indexes/
/assets/minecraft/

# ---------------------------------------------------------------------------
# 本地演示目录与本地截图（可能包含本机路径，不随仓库发布）
# ---------------------------------------------------------------------------
/demo/
/docs/*.png
